// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Venue {
  id               String                 @id @default(cuid())
  name             String
  address          String
  neighborhood     String?                // Chicago neighborhood (River North, Wicker Park, etc.)
  latitude         Float
  longitude        Float
  type             VenueType
  googlePlaceId    String?                @unique
  description      String?
  phoneNumber      String?
  website          String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  busynessObservations BusynessObservation[]
  crowdReports         CrowdReport[]
  videos               VenueVideo[]
  recurringEvents      RecurringEvent[]

  @@index([latitude, longitude])
  @@index([type])
  @@index([neighborhood])
}

enum VenueType {
  bar
  club
  latin_dance
}

model BusynessObservation {
  id        String              @id @default(cuid())
  venueId   String
  venue     Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  source    BusynessSource
  level     Int                 // 0-100
  timestamp DateTime            @default(now())

  @@index([venueId, timestamp])
  @@index([timestamp])
}

enum BusynessSource {
  provider
  crowd
}

model CrowdReport {
  id            String          @id @default(cuid())
  venueId       String
  venue         Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  level         CrowdLevel
  tags          String[]        // Array of tags like "good_music", "long_wait", "great_crowd"
  browserToken  String          // Fingerprint/session identifier
  ipAddress     String
  userAgent     String?
  userId        String?         // Optional: linked to authenticated user
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())

  @@index([venueId, createdAt])
  @@index([createdAt])
  @@index([browserToken])
  @@index([userId])
}

enum CrowdLevel {
  dead
  warm
  busy
  packed
}

model VenueVideo {
  id            String   @id @default(cuid())
  venueId       String
  venue         Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  videoUrl      String   // Base64 encoded video for MVP (switch to Supabase later)
  thumbnailUrl  String?  // Optional thumbnail
  browserToken  String   // Who uploaded
  latitude      Float?   // GPS verification
  longitude     Float?   // GPS verification
  userId        String?  // Optional: linked to authenticated user
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  expiresAt     DateTime // Auto-delete after 4 hours
  createdAt     DateTime @default(now())

  @@index([venueId, createdAt])
  @@index([expiresAt])
  @@index([userId])
}

// Recurring events at venues (e.g., Latin dance nights at bars)
model RecurringEvent {
  id            String      @id @default(cuid())
  venueId       String
  venue         Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name          String      // e.g., "Baila Tuesdays", "Tropical Wednesdays"
  eventType     EventType   // Type of event
  dayOfWeek     Int         // 0=Sunday, 1=Monday, ..., 6=Saturday
  startTime     String      // e.g., "20:00" (8 PM)
  endTime       String      // e.g., "02:00" (2 AM)
  description   String?     // Event details
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([venueId])
  @@index([dayOfWeek])
  @@index([eventType])
  @@unique([venueId, dayOfWeek, eventType])  // One event type per day per venue
}

enum EventType {
  latin_dance     // Salsa, Bachata, etc.
  swing_dance     // West Coast Swing, Lindy Hop
  live_music
  dj_night
  karaoke
  trivia
  other
}

// NextAuth.js models for Google OAuth
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Points and gamification
  points        Int       @default(0)
  reportsCount  Int       @default(0)
  videosCount   Int       @default(0)
  badges        String[]  // Array of badge IDs earned

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  crowdReports  CrowdReport[]
  venueVideos   VenueVideo[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
